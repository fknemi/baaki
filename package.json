{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "size-limit": [
    {
      "name": "Initial JS",
      "path": ".next/static/chunks/**/*.js",
      "limit": "220 KB",
      "gzip": true
    }
  ],
  "scripts": {
    "size": "size-limit",
    "size:check": "size-limit --json",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test src/",
    "test:watch": "bun test --watch src/",
    "test:cov": "bun test --coverage src/",
    "db:generate": "bun --env-file=.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local drizzle-kit migrate",
    "db:studio": "bun --env-file=.env.local drizzle-kit studio",
    "db:check": "bun --env-file=.env.local drizzle-kit check",
    "seed": "bun scripts/seed.mjs",
    "check:forbidden": "bun scripts/check-forbidden-tokens.mjs",
    "check:i18n": "bun scripts/check-i18n-parity.mjs",
    "check:secrets": "bun scripts/check-secrets-in-build.mjs",
    "check:trigger": "bash scripts/verify-trigger.sh",
    "check": "bun lint && bun typecheck && bun test && bun check:forbidden && bun check:i18n",
    "test:e2e": "playwright test",
    "test:e2e:journey": "playwright test tests/e2e/journey.spec.ts",
    "test:e2e:network": "playwright test tests/e2e/network.spec.ts",
    "test:e2e:goldens": "playwright test tests/e2e/print-goldens.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.30.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-app": "^14.2.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
